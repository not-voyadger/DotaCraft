        Location leftSpawn = spawnLoc.clone().add(leftVector);
        Location rightSpawn = spawnLoc.clone().add(rightVector);

        spawnForgeSpirit(player, leftSpawn);
        spawnForgeSpirit(player, rightSpawn);
        return true;
    }

