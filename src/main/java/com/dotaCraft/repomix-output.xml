    public void removePudgeModel() {
        Player player = getPlayer();

        if (modeledEntity != null && activeModel != null) {
            modeledEntity.removeModel("pudge");
        }

        if (player.isOnline()) {
            player.removePotionEffect(PotionEffectType.INVISIBILITY);
        }
    }
